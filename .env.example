# Worker environment contract.
#
# Docker image must use CUDA 12.8 / PyTorch 2.7+ for Blackwell GPUs (sm_120).
# Older CUDA 12.4 images fail RunPod fitness checks on RTX PRO 6000 / similar.
#
# In production these are set as RunPod endpoint secrets (RunPod injects env
# vars directly into the container) - this file is not loaded automatically
# by anything in this repo. It documents what to export locally before
# running, e.g.:
#   python handler.py --test_input tests/test_input_classify.json

OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-5-mini

PREPROCESSING_SEGMENTATION_MODEL=birefnet-general-lite

# Recommend a separate, scoped R2 API token from the backend's - not a copy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=vehicle-transform-private-dev

# Must match the Dockerfile's baked-model path in production; defaults to
# ./models/rembg relative to the repo root otherwise.
MODEL_CACHE_DIR=/app/models/rembg
